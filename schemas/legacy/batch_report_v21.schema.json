{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zend-decompiler/batch-v21",
  "title": "Zend Decompiler v21 batch report",
  "type": "object",
  "required": ["version", "total", "generated", "unsupported", "not_encoded", "files", "semantic_equivalence_proven"],
  "properties": {
    "version": {"type": "string"},
    "total": {"type": "integer", "minimum": 0},
    "generated": {"type": "integer", "minimum": 0},
    "unsupported": {"type": "integer", "minimum": 0},
    "not_encoded": {"type": "integer", "minimum": 0},
    "semantic_equivalence_proven": {"const": false},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "input_sha256", "status"],
        "properties": {
          "source": {"type": "string"},
          "status": {"enum": ["candidate_generated", "unsupported", "not_encoded"]},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "opcode_recognition_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"},
          "partial_diagnostic": {"type": "string"}
        }
      }
    }
  }
}
